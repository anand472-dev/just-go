+
+// Corpus recorder. Does nothing unless JUST_RECORD_FILE is set.
+mod recorder {
+  use {
+    super::*,
+    serde_json::Value,
+    std::{cell::Cell, sync::Mutex},
+  };
+
+  static LOCK: Mutex<()> = Mutex::new(());
+
+  thread_local! {
+    static COUNTER: Cell<u32> = const { Cell::new(0) };
+  }
+
+  fn record_file() -> Option<PathBuf> {
+    env::var_os("JUST_RECORD_FILE").map(PathBuf::from)
+  }
+
+  // Placeholders for the machine-specific absolute paths that appear in
+  // cases. A runner substitutes its own values back before it runs a case:
+  // `@@TEMPDIR@@` is the case's temporary directory (with symbolic links
+  // resolved), `@@TEMPDIR_PARENT@@` is the directory that contains it, and
+  // `@@JUST_EXECUTABLE@@` is the absolute path of the binary under test.
+  const TEMPDIR_TOKEN: &str = "@@TEMPDIR@@";
+  const TEMPDIR_PARENT_TOKEN: &str = "@@TEMPDIR_PARENT@@";
+  const JUST_EXECUTABLE_TOKEN: &str = "@@JUST_EXECUTABLE@@";
+
+  type Forms = Vec<(String, &'static str)>;
+
+  // The tempdir as `Test` knows it and in canonical form (on macOS
+  // `/private/var/...`).
+  fn tempdir_roots(root: &Path) -> Vec<PathBuf> {
+    let mut roots = vec![root.to_owned()];
+    if let Ok(canonical) = fs::canonicalize(root) {
+      if canonical != root {
+        roots.push(canonical);
+      }
+    }
+    roots
+  }
+
+  // Every spelling that can appear in a case, as plain text and escaped for
+  // use inside a regex, paired with its placeholder. Longest first, so that
+  // a spelling is never replaced inside a longer one.
+  fn tempdir_forms(roots: &[PathBuf]) -> Forms {
+    let mut paths = Vec::new();
+    for root in roots {
+      paths.push((root.to_str(), TEMPDIR_TOKEN));
+      paths.push((root.parent().and_then(Path::to_str), TEMPDIR_PARENT_TOKEN));
+    }
+    paths.push((Some(env!("CARGO_BIN_EXE_just")), JUST_EXECUTABLE_TOKEN));
+
+    let mut forms = Forms::new();
+    for (text, token) in paths {
+      let Some(text) = text else { continue };
+      for form in [text.to_owned(), regex::escape(text)] {
+        if !forms.iter().any(|(existing, _)| *existing == form) {
+          forms.push((form, token));
+        }
+      }
+    }
+    forms.sort_by_key(|(form, _)| std::cmp::Reverse(form.len()));
+    forms
+  }
+
+  fn scrub(text: &str, forms: &Forms) -> String {
+    let mut text = text.to_owned();
+    for (form, token) in forms {
+      text = text.replace(form.as_str(), token);
+    }
+    text
+  }
+
+  fn scrub_value(value: &mut Value, forms: &Forms) {
+    match value {
+      Value::String(text) => *text = scrub(text, forms),
+      Value::Array(items) => items.iter_mut().for_each(|item| scrub_value(item, forms)),
+      Value::Object(map) => map.values_mut().for_each(|item| scrub_value(item, forms)),
+      _ => {}
+    }
+  }
+
+  fn base64(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut out = String::new();
+    for chunk in bytes.chunks(3) {
+      let n = (u32::from(chunk[0]) << 16)
+        | (u32::from(*chunk.get(1).unwrap_or(&0)) << 8)
+        | u32::from(*chunk.get(2).unwrap_or(&0));
+      for i in 0..4 {
+        if i <= chunk.len() {
+          out.push(TABLE[((n >> (18 - 6 * i)) & 63) as usize] as char);
+        } else {
+          out.push('=');
+        }
+      }
+    }
+    out
+  }
+
+  fn walk(root: &Path, dir: &Path, files: &mut BTreeMap<String, String>) {
+    let Ok(entries) = fs::read_dir(dir) else {
+      return;
+    };
+    for entry in entries.flatten() {
+      let path = entry.path();
+      let Ok(metadata) = fs::symlink_metadata(&path) else {
+        continue;
+      };
+      if metadata.is_dir() {
+        walk(root, &path, files);
+      } else if metadata.is_file() {
+        // Files whose name or content is not valid UTF-8 cannot be
+        // represented in the corpus and are left out.
+        let relative = path.strip_prefix(root).unwrap().to_str().map(str::to_owned);
+        if let (Some(relative), Ok(content)) = (relative, fs::read_to_string(&path)) {
+          files.insert(relative.replace('\\', "/"), content);
+        }
+      }
     }
   }
+
+  // Captures the files in the tempdir as they are before just runs.
+  pub(super) fn snapshot(root: &Path) -> Option<BTreeMap<String, String>> {
+    record_file()?;
+    let mut files = BTreeMap::new();
+    walk(root, root, &mut files);
+    Some(files)
+  }
+
+  pub(super) fn record(
+    test: &Test,
+    files: Option<BTreeMap<String, String>>,
+    status: i32,
+    stdout: &str,
+    stderr: &str,
+  ) {
+    let (Some(file), Some(files)) = (record_file(), files) else {
+      return;
+    };
+
+    let Some(cwd) = test.current_dir.to_str() else {
+      return;
+    };
+
+    let thread = thread::current();
+    let counter = COUNTER.with(|counter| {
+      counter.set(counter.get() + 1);
+      counter.get()
+    });
+    let id = format!("{}#{counter}", thread.name().unwrap_or("unnamed"));
+
+    // `Test::path` REPLACES `PATH` with an absolute path inside the tempdir
+    // (it does not prepend). When every element of `PATH` lies inside the
+    // tempdir, record the elements relative to it in `path_extra` and drop
+    // `PATH` from `env`. Otherwise leave `PATH` in `env`; the tempdir inside
+    // it is replaced by the placeholder below.
+    let roots = tempdir_roots(test.tempdir.path());
+    let forms = tempdir_forms(&roots);
+    let mut env = test.env.clone();
+    let mut path_extra = Vec::new();
+    if let Some(value) = env.get("PATH") {
+      let relative = env::split_paths(value)
+        .map(|entry| {
+          roots
+            .iter()
+            .find_map(|root| entry.strip_prefix(root).ok())
+            .and_then(Path::to_str)
+            .map(|relative| {
+              if relative.is_empty() {
+                ".".to_owned()
+              } else {
+                relative.replace('\\', "/")
+              }
+            })
+        })
+        .collect::<Option<Vec<_>>>();
+      if let Some(relative) = relative {
+        path_extra = relative;
+        env.remove("PATH");
+      }
+    }
+
+    // The command line the harness runs, including the `--shell` argument.
+    let mut args = Vec::new();
+    if test.shell {
+      args.push("--shell".to_owned());
+      args.push("bash".to_owned());
+    }
+    args.extend(test.args.iter().cloned());
+
+    let expected_files = test
+      .expected_files
+      .iter()
+      .map(|(path, content)| {
+        let content = match str::from_utf8(content) {
+          Ok(text) => scrub(text, &forms).into_bytes(),
+          Err(_) => content.clone(),
+        };
+        (path.to_string_lossy().replace('\\', "/"), base64(&content))
+      })
+      .collect::<BTreeMap<_, _>>();
+
+    let mut case = json!({
+      "id": id,
+      "files": files,
+      "args": args,
+      "env": env,
+      "path_extra": path_extra,
+      "cwd": cwd,
+      "stdin": test.stdin,
+      "stdout_regex": test.stdout_regex.as_ref().map(Regex::as_str),
+      "stderr_regex": test.stderr_regex.as_ref().map(Regex::as_str),
+      "status": status,
+      "expected_files": expected_files,
+      "response": test.response.as_ref().map(|response| serde_json::to_value(response).unwrap()),
+    });
+
+    let object = case.as_object_mut().unwrap();
+    if test.stdout_regex.is_none() {
+      object.insert("stdout".into(), stdout.into());
+    }
+    if test.stderr_regex.is_none() {
+      object.insert("stderr".into(), stderr.into());
+    }
+    scrub_value(&mut case, &forms);
+
+    let line = format!("{case}\n");
+    let _guard = LOCK.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut handle = fs::OpenOptions::new()
+      .create(true)
+      .append(true)
+      .open(file)
+      .expect("failed to open JUST_RECORD_FILE");
+    handle
+      .write_all(line.as_bytes())
+      .expect("failed to write JUST_RECORD_FILE");
+  }
 }
